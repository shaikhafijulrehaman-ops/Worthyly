# SmartBuy AI - Environment Configuration Example
# Copy this file to .env and adjust variables as needed.
# NEVER commit real API keys or secrets to Git.

# Server Ports
PORT=8000
VITE_PORT=5173

# Originkit Component CLI API Key (Optional)
# If set, originkit CLI will authenticate when installing extra components.
# If unset, the application automatically uses the polished CSS/SVG Neon Border fallback.
ORIGINKIT_API_KEY=

# Supabase Configuration (Optional - application runs offline demo mode without it)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Recommendation Engine Settings
RECOMMENDATION_MAX_RESULTS=3
DEFAULT_STRICT_BUDGET=true
