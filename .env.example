# WORTHLY - Environment Configuration Example
# Copy this file to .env and adjust variables as needed.
# NEVER commit real API keys or secrets to Git.

# Server Configuration
PORT=8000
VITE_PORT=5173

# External Retailer Product Data APIs (Optional)
# If left blank, WORTHLY relies on its verified Product Master dataset.
# Set these credentials to enable real-time lookup of uncataloged items.

# Amazon Product Advertising API (PA-API 5.0)
# Requirements: Active Amazon Associates account with 3 qualifying sales in the last 180 days.
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PAAPI_ASSOCIATE_TAG=
AMAZON_PAAPI_REGION=in

# Flipkart Affiliate API
# Requirements: Registered Flipkart Affiliate Publisher account.
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=

# Originkit Component CLI API Key (Optional)
# If set, originkit CLI will authenticate when installing extra components.
# If unset, the application automatically uses the polished CSS/SVG Neon Border fallback.
ORIGINKIT_API_KEY=

# Supabase Configuration (Optional - application runs in local JSON catalog mode without it)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Recommendation Engine Settings
RECOMMENDATION_MAX_RESULTS=3
DEFAULT_STRICT_BUDGET=true
